# ── AI chat assistant (/api/chat) ────────────────────────────────────────────
# Gemini API key, used server-side only. Create one at
# https://aistudio.google.com/apikey and set it locally in .env.local and on the
# host (Vercel → Project → Settings → Environment Variables).
#
# Never rename it with a NEXT_PUBLIC_ prefix — that would inline the key into
# the browser bundle. Unset, the launcher still renders and /api/chat answers
# 503, which the widget shows as "offline".
GEMINI_API_KEY=

# ── Code search (the assistant's searchCode tool) ────────────────────────────
# Neon Postgres, provisioned through Vercel → Marketplace → Neon. Use a Neon
# development branch locally; never point local runs at the production branch.
# Server-only. Unset, the assistant still answers from the site content but
# does not offer code search.
DATABASE_URL=
